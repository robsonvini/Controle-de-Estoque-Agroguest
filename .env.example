# =====================================================================
# Estoque Agrogest — variáveis de ambiente (exemplo)
# Copie para apps/api/.env e ajuste. Nunca versione o arquivo .env real.
# Em homologação e produção, os valores vêm do AWS Secrets Manager.
# =====================================================================

# --- Aplicação ---
NODE_ENV=development
PORT=3333
# URL pública do frontend (CORS e cookies)
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Confia no cabeçalho X-Forwarded-For (true atrás do ALB)
TRUST_PROXY=false

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL=postgresql://estoque:estoque_dev@localhost:5432/estoque?schema=public
# Usado pelos testes de integração (banco separado)
DATABASE_URL_TEST=postgresql://estoque:estoque_dev@localhost:5432/estoque_test?schema=public

# --- Autenticação ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-longo-e-aleatorio-de-acesso
JWT_INTEGRACAO_SECRET=troque-por-um-segredo-longo-e-aleatorio-de-integracao
ACCESS_TOKEN_TTL_SEGUNDOS=900
REFRESH_TOKEN_TTL_DIAS=7
# Cookies "Secure" exigem HTTPS; use false apenas em desenvolvimento local
COOKIE_SECURE=false
LOGIN_MAX_TENTATIVAS=5
# Limite de requisições de login por minuto por IP
LOGIN_LIMITE_POR_MINUTO=10
LOGIN_BLOQUEIO_MINUTOS=15

# Chave de 32 bytes em base64 para cifrar credenciais de integração (AES-256-GCM)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRYPTO_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Administrador inicial (criado pelo seed apenas se não existir) ---
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_EMAIL=admin@agrogest.local
SEED_ADMIN_SENHA="Troque@Esta#Senha123"

# --- Armazenamento de arquivos (S3; em desenvolvimento, s3mock) ---
S3_BUCKET=estoque-arquivos
S3_REGION=us-east-1
# Em desenvolvimento aponta para o s3mock; na AWS deixe vazio (usa o S3 e a role da tarefa)
S3_ENDPOINT=http://localhost:9090
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev

# --- E-mail (notificações) ---
EMAIL_HABILITADO=false
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE="Estoque Agrogest <estoque@agrogest.local>"

# --- Integração com o CRM Agrogest ---
# Valores iniciais; depois de criada, a configuração é mantida pela tela "Integração CRM"
CRM_BASE_URL=http://localhost:8000
CRM_TIMEOUT_MS=10000
CRM_SYNC_INTERVALO_MINUTOS=15

# --- Worker (fila de processamento) ---
WORKER_INTERVALO_MS=2000
WORKER_LOTE=20
